<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>PersonnelVault</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Always copy the CSV to the output (bin) folder too, otherwise it is not found at runtime. -->
    <None Update="Data\sample_people.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
